<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Moka.Docs.Plugins</RootNamespace>
    <Description>Plugin host, built-in plugins, and plugin abstractions for MokaDocs.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Moka.Docs.Core\Moka.Docs.Core.csproj" />
    <ProjectReference Include="..\Moka.Docs.Engine\Moka.Docs.Engine.csproj" />
    <ProjectReference Include="..\Moka.Docs.Serve\Moka.Docs.Serve.csproj" />
    <PackageReference Include="Moka.Blazor.Repl.Compiler" />
    <PackageReference Include="Moka.Blazor.Repl.Wasm" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- OpenAPI documents are read with System.Text.Json and YamlDotNet, not Microsoft.OpenApi: an app
         loads one version of that, and 2.x here broke the 1.x that Microsoft.AspNetCore.OpenApi 9 and
         Swashbuckle 9 need. -->
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <!-- Embed the Python analyzer script so the PythonApiPlugin can extract it
       to a temp file and invoke it via subprocess at build time. -->
  <ItemGroup>
    <EmbeddedResource Include="PythonApi\mokadocs_python_analyzer.py" />
  </ItemGroup>

</Project>
