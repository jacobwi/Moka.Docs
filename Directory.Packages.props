<Project>
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<!-- Lets a PackageVersion entry below also pin a *transitive* dependency, which is how
		     the NuGet.* pins at the bottom of this file take effect. -->
		<CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
	</PropertyGroup>
	<ItemGroup>
		<!-- CLI & Console -->
		<PackageVersion Include="Moka.Blazor.Repl.Compiler" Version="1.3.6" />
		<PackageVersion Include="Moka.Blazor.Repl.Wasm" Version="1.3.6" />
		<PackageVersion Include="System.CommandLine" Version="3.0.0" />
		<PackageVersion Include="Spectre.Console" Version="0.57.2" />
		<!-- Markdown -->
		<PackageVersion Include="Markdig" Version="1.6.0" />
		<!-- Templating -->
		<PackageVersion Include="Scriban" Version="7.6.1" />
		<!-- Roslyn / C# Analysis -->
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.9.0" />
		<!-- File System Abstraction -->
		<PackageVersion Include="System.IO.Abstractions" Version="23.0.0" />
		<PackageVersion Include="TestableIO.System.IO.Abstractions.Wrappers" Version="23.0.0" />
		<PackageVersion Include="TestableIO.System.IO.Abstractions.TestingHelpers" Version="23.0.0" />
		<!-- DI / Logging / Configuration (.NET 10 compatible) -->
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.15" />
		<!-- Feature Management -->
		<PackageVersion Include="Microsoft.FeatureManagement" Version="4.8.0" />
		<PackageVersion Include="Microsoft.Extensions.FileProviders.Physical" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
		<!-- YAML -->
		<PackageVersion Include="YamlDotNet" Version="18.1.0" />
		<!-- OpenAPI -->
		<!-- Samples.Api and the integration tests pin their net9.0 legs down to 9.0.23 via VersionOverride.
		     No Microsoft.OpenApi entry on purpose: with transitive pinning it would force one version onto
		     both legs, and the 9.x packages need 1.x where the 10.x ones need 2.x. MokaDocs itself doesn't
		     reference it. -->
		<PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
		<!-- Integration tests only. The net9.0 leg overrides it to 9.0.6, which is built on
		     Microsoft.OpenApi 1.x like Microsoft.AspNetCore.OpenApi 9; 10.x is built on 2.x. -->
		<PackageVersion Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.3.1" />
		<!-- Testing (xUnit v3) -->
		<PackageVersion Include="xunit.v3" Version="4.0.3" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
		<!-- Supplies the trx report handler CI asks for. Only TrxReport.Abstractions
		     arrives transitively, so without this the trx switch runs zero tests and
		     exits 5. Pinned to the Microsoft.Testing.Platform version in the graph. -->
		<PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.3" />
		<PackageVersion Include="FluentAssertions" Version="8.11.0" />
		<PackageVersion Include="NSubstitute" Version="6.2.0" />
		<PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
		<!-- Transitive pin. NuGet.Packaging 7.9.0, which Moka.Blazor.Repl.Compiler brings in, lists
		     System.Security.Cryptography.Pkcs 8.0.1 (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). The
		     compiler's own Pkcs dependency outranks it since 1.3.6; the pin keeps both legs on the
		     latest .NET 10 patch whatever the compiler lists. -->
		<PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
	</ItemGroup>
</Project>
